{
	"name": "@tldraw/dotcom-server",
	"description": "The self-hosted UnoCode backend: directory, presence and asset storage.",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"scripts": {
		"dev": "yarn run -T tsx watch src/index.ts",
		"start": "yarn run -T tsx src/index.ts",
		"lint": "yarn run -T tsx ../../../internal/scripts/lint.ts",
		"test": "yarn run -T vitest --passWithNoTests",
		"test-ci": "yarn run -T vitest run --passWithNoTests",
		"test-coverage": "yarn run -T vitest run --coverage --passWithNoTests"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.750.0",
		"@tldraw/dotcom-shared": "workspace:*",
		"@tldraw/utils": "workspace:*",
		"itty-router": "^5.0.18",
		"ws": "^8.18.1"
	},
	"devDependencies": {
		"@types/node": "^22.13.5",
		"@types/ws": "^8.18.1",
		"tsx": "^4.19.2",
		"vitest": "^4.1.7"
	}
}
